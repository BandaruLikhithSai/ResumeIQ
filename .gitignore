# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
venv/
env/
.venv/
.env/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
!.env.example        # keep the example, never commit real secrets

# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
instance/

# ── Uploads (user files — never commit) ──────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Flask / Migrations ────────────────────────────────────────────────────────
migrations/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Vite cache ────────────────────────────────────────────────────────────────
.vite/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
